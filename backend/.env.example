PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/maintenance_db
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars
FRONTEND_URL=http://localhost:5173
# Only needed if the frontend and API are deployed on different subdomains
# of the same registrable domain (e.g. app.example.com + api.example.com).
# Leave unset for local dev and for same-origin/reverse-proxy deployments.
# COOKIE_DOMAIN=.example.com

# Web Push (PWA notifications). Optional: with these unset, push is disabled
# and notifications still appear in the app's in-app feed.
# Generate a key pair once per deployment with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact URI the push service can reach you at (mailto: or https:).
# VAPID_SUBJECT=mailto:admin@example.com
